{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide",
  "type": "object",
  "required": [
    "slide_number",
    "title",
    "content"
  ],
  "properties": {
    "slide_number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}